{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vln.local/generator/repair.schema.json",
  "title": "VLN Generator bounded repair envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "responses"
  ],
  "properties": {
    "candidate": {
      "$ref": "https://vln.local/generator/output.schema.json"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_index",
          "decision",
          "source_quotes",
          "reason"
        ],
        "properties": {
          "finding_index": {
            "type": "integer",
            "minimum": 0
          },
          "decision": {
            "enum": [
              "accept",
              "partially_accept",
              "reject",
              "unresolved"
            ]
          },
          "source_quotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
