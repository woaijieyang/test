{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vln.local/generator/output.schema.json",
  "title": "VLN Generator runtime output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "subtasks",
    "issues",
    "stage_audit",
    "handoffs"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "needs_review"
      ]
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "source_quote",
          "problem"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stage_audit": {
      "type": "array",
      "items": {
        "$ref": "https://vln.local/shared/template_schemas_v1_5_2/stage_audit.schema.json"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "https://vln.local/shared/template_schemas_v1_5_2/handoff.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "subtasks": {
            "minItems": 1
          },
          "issues": {
            "maxItems": 0
          },
          "stage_audit": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "subtasks": {
            "maxItems": 0
          },
          "stage_audit": {
            "maxItems": 0
          },
          "handoffs": {
            "maxItems": 0
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
