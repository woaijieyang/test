{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vln.local/reviewer/output.schema.json",
  "title": "VLN Reviewer runtime output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "dimensions",
    "source_coverage",
    "layer_checks",
    "findings",
    "stage_checks",
    "handoffs",
    "prior_finding_reviews"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "revise",
        "unresolved"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fidelity",
        "closure_handoff",
        "segmentation_adequacy"
      ],
      "properties": {
        "source_fidelity": {
          "enum": [
            "pass",
            "issue",
            "source_limited",
            "not_assessable"
          ]
        },
        "closure_handoff": {
          "enum": [
            "pass",
            "issue",
            "source_limited",
            "not_assessable"
          ]
        },
        "segmentation_adequacy": {
          "enum": [
            "pass",
            "issue",
            "source_limited",
            "not_assessable"
          ]
        }
      }
    },
    "source_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "source_quote",
          "requirement",
          "candidate_evidence",
          "status"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "candidate_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subtask_index",
                "quote"
              ],
              "properties": {
                "subtask_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "status": {
            "enum": [
              "covered",
              "omitted",
              "altered_or_missing",
              "superseded",
              "requires_review"
            ]
          }
        }
      }
    },
    "layer_checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "status",
          "finding_indices",
          "conclusion"
        ],
        "properties": {
          "layer": {
            "enum": [
              "L0_integrity",
              "L1_source_coverage",
              "L2_dependencies",
              "L3_stage_checks",
              "L4_handoffs",
              "L5_grouping",
              "L6_route_readback"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "issue",
              "source_limited",
              "not_applicable"
            ]
          },
          "finding_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "failed_layer",
          "c_check",
          "dimension",
          "related_dimensions",
          "affected_subtask_indices",
          "source_requirement_ids",
          "source_quote",
          "candidate_evidence",
          "evidence_level",
          "problem",
          "execution_consequence",
          "repair"
        ],
        "properties": {
          "code": {
            "enum": [
              "MISSING_ENTRY_ANCHOR",
              "OPEN_INTERMEDIATE_STAGE",
              "OMISSION",
              "UNSUPPORTED_ADDITION",
              "WRONG_ORDER",
              "WRONG_REFERENCE_FRAME",
              "COUNT_SCOPE_DRIFT",
              "DETACHED_CONDITION",
              "WRONG_TARGET",
              "WRONG_RELATION",
              "LOST_EVENT",
              "OVERSEGMENTED",
              "UNDERSEGMENTED",
              "SOURCE_AMBIGUITY",
              "OVERREJECTION",
              "OTHER_MATERIAL_DEFECT"
            ]
          },
          "failed_layer": {
            "enum": [
              "L0_integrity",
              "L1_source_coverage",
              "L2_dependencies",
              "L3_stage_checks",
              "L4_handoffs",
              "L5_grouping",
              "L6_route_readback"
            ]
          },
          "c_check": {
            "enum": [
              "C01",
              "C02",
              "C03",
              "C04",
              "C05",
              "C06",
              "C07",
              "C08",
              "C09",
              "C10",
              "C11",
              "C12"
            ]
          },
          "dimension": {
            "enum": [
              "source_fidelity",
              "closure_handoff",
              "segmentation_adequacy"
            ]
          },
          "related_dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "source_fidelity",
                "closure_handoff",
                "segmentation_adequacy"
              ]
            },
            "uniqueItems": true
          },
          "affected_subtask_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "source_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "candidate_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subtask_index",
                "quote"
              ],
              "properties": {
                "subtask_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidence_level": {
            "enum": [
              "S1",
              "S2"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "execution_consequence": {
            "type": "string",
            "minLength": 1
          },
          "repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "affected_subtask_indices",
              "instruction",
              "protected_requirements"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "bind_entry",
                  "merge",
                  "restore",
                  "remove",
                  "reorder",
                  "regroup",
                  "clarify_reference",
                  "abstain",
                  "correct_refusal",
                  "preserve_uncertainty"
                ]
              },
              "affected_subtask_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "protected_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "stage_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subtask_index",
          "status",
          "entry",
          "target",
          "process",
          "ending",
          "conditions",
          "source_requirement_ids",
          "source_quotes",
          "carryover"
        ],
        "properties": {
          "subtask_index": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "supported",
              "gap",
              "source_limited"
            ]
          },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "text",
              "candidate_quotes"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "episode_start",
                  "explicit_context",
                  "inherited_pose",
                  "inherited_entity",
                  "missing",
                  "source_unspecified"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "candidate_quotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "candidate_quotes"
            ],
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "candidate_quotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "process": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "candidate_quotes"
            ],
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "candidate_quotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "ending": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text",
              "candidate_quotes",
              "stop_scope"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "explicit_event",
                  "bounded_action",
                  "linked_trigger_or_refinement",
                  "terminal_goal_directive",
                  "unspecified"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "candidate_quotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stop_scope": {
                "enum": [
                  "none",
                  "intermediate",
                  "terminal"
                ]
              }
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "candidate_quotes"
            ],
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "candidate_quotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "source_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_quotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "carryover": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "https://vln.local/shared/template_schemas_v1_5_2/handoff.schema.json"
      }
    },
    "prior_finding_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_index",
          "status",
          "candidate_evidence",
          "explanation"
        ],
        "properties": {
          "finding_index": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "resolved",
              "partially_resolved",
              "unresolved"
            ]
          },
          "candidate_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subtask_index",
                "quote"
              ],
              "properties": {
                "subtask_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
