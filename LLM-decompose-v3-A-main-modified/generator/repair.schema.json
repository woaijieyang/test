{
  "type": "object",
  "properties": {
    "candidate": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "needs_review"
          ]
        },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNRESOLVED_REFERENCE",
                  "CONFLICTING_REQUIREMENTS",
                  "UNCLEAR_SCOPE",
                  "UNSUPPORTED_COMPLETION",
                  "NO_EXECUTABLE_REQUIREMENT"
                ]
              },
              "source_quote": {
                "type": "string"
              },
              "problem": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "source_quote",
              "problem"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "subtasks",
        "issues"
      ],
      "additionalProperties": false
    },
    "feedback_response": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "partially_accept",
              "reject",
              "unresolved"
            ]
          },
          "source_quotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding_id",
          "decision",
          "source_quotes",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "candidate",
    "feedback_response"
  ],
  "additionalProperties": false
}
