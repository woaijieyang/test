{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLN Independent Reviewer Few-shot Template v1.5.1",
  "type": "object",
  "required": [
    "schema_version",
    "template_id",
    "role",
    "dataset_scope",
    "language",
    "pair_id",
    "source",
    "provenance",
    "review_input",
    "expected_review",
    "teaching_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "reviewer-v1.5.1-template"
    },
    "template_id": {
      "type": "string"
    },
    "role": {
      "const": "reviewer"
    },
    "dataset_scope": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object"
    },
    "provenance": {
      "type": [
        "object",
        "string"
      ]
    },
    "review_input": {
      "type": "object",
      "required": [
        "original_instruction",
        "candidate"
      ]
    },
    "expected_review": {
      "type": "object",
      "required": [
        "verdict",
        "dimensions",
        "source_coverage",
        "layer_checks",
        "findings",
        "stage_checks",
        "handoffs"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "revise",
            "unresolved"
          ]
        },
        "dimensions": {
          "type": "object"
        },
        "source_coverage": {
          "type": "array"
        },
        "layer_checks": {
          "type": "array",
          "minItems": 7
        },
        "findings": {
          "type": "array"
        },
        "stage_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subtask_index",
              "status",
              "entry",
              "target",
              "process",
              "ending",
              "conditions",
              "source_requirement_ids",
              "source_quotes",
              "carryover"
            ],
            "properties": {
              "subtask_index": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "supported",
                  "gap",
                  "source_limited"
                ]
              },
              "entry": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "text",
                  "candidate_quotes"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "episode_start",
                      "explicit_context",
                      "inherited_pose",
                      "inherited_entity",
                      "missing",
                      "source_unspecified"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "candidate_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "candidate_quotes"
                ],
                "properties": {
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "candidate_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "process": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "candidate_quotes"
                ],
                "properties": {
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "candidate_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "ending": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text",
                  "candidate_quotes",
                  "stop_scope"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "explicit_event",
                      "bounded_action",
                      "linked_trigger_or_refinement",
                      "terminal_goal_directive",
                      "unspecified"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "candidate_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "stop_scope": {
                    "type": "string",
                    "enum": [
                      "none",
                      "intermediate",
                      "terminal"
                    ],
                    "description": "Independently classify whether the stage ending is an explicit physical stop/wait and whether the episode continues."
                  }
                }
              },
              "conditions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "candidate_quotes"
                ],
                "properties": {
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "candidate_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "source_requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[0-9]{2,}$"
                }
              },
              "source_quotes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "carryover": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "handoffs": {
          "type": "array",
          "items": {
            "$ref": "handoff.schema.json"
          }
        }
      }
    },
    "teaching_notes": {
      "type": "object"
    }
  },
  "$comment": "Python validator enforces exactly seven ordered L0-L6 layer checks, one stage check per candidate stage, one handoff per adjacent pair, and valid source requirement IDs."
}
