{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLN canonical Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from_subtask_index",
    "to_subtask_index",
    "status",
    "preceding_exit",
    "next_entry",
    "shared_context",
    "source_requirement_ids",
    "handoff_rationale"
  ],
  "properties": {
    "from_subtask_index": {
      "type": "integer",
      "minimum": 0
    },
    "to_subtask_index": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "supported",
        "gap",
        "source_limited"
      ]
    },
    "preceding_exit": {
      "$ref": "#/$defs/endpoint"
    },
    "next_entry": {
      "$ref": "#/$defs/endpoint"
    },
    "shared_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "source_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{2,}$"
      },
      "uniqueItems": true
    },
    "handoff_rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "candidate_quote"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "candidate_quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity_or_region",
            "orientation",
            "count_origin",
            "temporal_state",
            "inherited_context"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
