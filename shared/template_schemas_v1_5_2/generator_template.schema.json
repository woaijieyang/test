{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLN Generator Few-shot Template",
  "type": "object",
  "required": [
    "schema_version",
    "template_id",
    "role",
    "dataset_scope",
    "language",
    "source",
    "provenance",
    "input",
    "decision",
    "output",
    "teaching_notes",
    "retrieval_tags"
  ],
  "properties": {
    "schema_version": {
      "const": "generator-v1.5.1-template"
    },
    "template_id": {
      "type": "string"
    },
    "role": {
      "const": "generator"
    },
    "dataset_scope": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "input": {
      "type": "object",
      "required": [
        "original_instruction"
      ],
      "properties": {
        "original_instruction": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "mode",
        "rationale"
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "status",
        "subtasks",
        "stage_audit",
        "handoffs",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "needs_review"
          ]
        },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage_audit": {
          "type": "array",
          "items": {
            "$ref": "stage_audit.schema.json"
          }
        },
        "handoffs": {
          "type": "array",
          "items": {
            "$ref": "handoff.schema.json"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "teaching_notes": {
      "type": "object"
    },
    "retrieval_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Cross-array invariants are checked by validate_templates.py: ok => audit_count=subtask_count and handoff_count=max(0,subtask_count-1); needs_review => no partial subtasks/audits/handoffs."
}
